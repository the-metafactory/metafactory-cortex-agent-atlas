#!/usr/bin/env bun
/**
 * `atlas-status` — the shipped CLI shim for `atlas status` (atlas#28).
 *
 * Deliberately the THINNEST possible file: argv/env/clock in, `runAtlasStatus`
 * (brain/status-cli.ts) out, print, exit. All read-only-by-construction
 * reasoning lives in status-cli.ts's header, not here — there is nothing in
 * this file capable of drifting from it because there is nothing else in
 * this file.
 */
import { runAtlasStatus } from "../brain/status-cli";

const result = await runAtlasStatus(process.argv.slice(2), process.env, Date.now());
process.stdout.write(result.output);
process.exit(result.exitCode);
